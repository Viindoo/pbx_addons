<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <div t-name="asterisk_plus_phone.menu" owl="1">
        <a data-hotkey="p" href="#" class="toggle-phone" title="Toggle Phone" t-on-click="_onClick" t-on-contextmenu="_onContextmenu">
            <i aria-label="Toggle Phone" class="icon-call fa-fw" role="img"/>
        </a>

        <a t-if="!state.isDisplay and state.inCall" aria-label="HangUp" class="hang-up-popup" title="HangUp" t-on-click="_onClickHangUp">
            <i class="icon-call_end reject-call"/>
        </a>

        <div id="rMenu" t-ref="rMenu" t-attf-class="rmenu d-flex flex-column{{state.isContextMenu ? '' : ' hide'}}" tabindex="-1">
            <div>
                <span t-on-click="_onClickBugReport">Bug Report</span>
            </div>
        </div>

        <div t-if="state.isReportModal" t-attf-class="modal{{state.isReportModal ? ' show': ''}}" tabindex="-1" role="dialog">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Phone Bug Report</h5>
                    </div>
                    <div class="modal-body">
                        <textarea t-ref="bugDescription" rows="6" cols="50" placeholder="Bug description (required)"/>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-primary"  t-on-click="_onClickSendReport">Send Report</button>
                        <button type="button" class="btn btn-secondary" t-on-click="_onClickCloseReport">Close</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

</templates>